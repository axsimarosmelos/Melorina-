# Local development: copy to .env, add your key, run npm run start:voice.
# Hosted deployment: use Render's secret/environment settings, not this file.
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4.1-mini
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
OPENAI_SPEECH_MODEL=gpt-4o-mini-tts
PORT=4173
MELORINA_MODE=local

# For a non-Render host: set hosted mode and every variable below.
# In production NODE_ENV=production also requires hosted mode.
# MELORINA_MODE=hosted
# MELORINA_PUBLIC_ORIGIN=https://your-service.example.com
# MELORINA_ALLOWED_ORIGINS=https://axsimarosmelos.github.io
# MELORINA_APP_URL=https://axsimarosmelos.github.io/Melorina-/
# MELORINA_DATA_DIR=/absolute/path/to/persistent/data
# MELORINA_INVITE_CODE=GENERATE_A_PRIVATE_RANDOM_SECRET_AT_LEAST_16_CHARACTERS
# MELORINA_DAILY_UNITS=80
# MELORINA_GLOBAL_DAILY_UNITS=1000
# MELORINA_MAX_ACCOUNTS=100
